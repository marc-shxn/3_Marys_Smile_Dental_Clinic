# Resend is preferred for hosted email. Keep this API key server-side only.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
TEST_EMAIL_TO=

# SMTP fallback when RESEND_API_KEY is not set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

ADMIN_MFA_ENCRYPTION_KEY=
REQUIRE_HTTPS=false
TRUST_PROXY=false
