# Reference only. Hosted secrets belong in Render's environment settings, not this file.
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
UPLOADS_DIR=/var/data/clinic
DATABASE_SSL=require
PG_POOL_MAX=8
REQUIRE_HTTPS=true
TRUST_PROXY=true

# Required secrets configured in Render's secret manager.
DATABASE_URL=
ADMIN_MFA_ENCRYPTION_KEY=
ROBOFLOW_API_KEY=
# Use Resend or the SMTP fallback below. Keep provider credentials in Render secrets.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional project identifiers; the backend connects through DATABASE_URL.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ROBOFLOW_WORKSPACE_SLUG=marcs-workspace-csjba
ROBOFLOW_WORKFLOW_ID=ai-oral-health-assessment-vai-oral-health-assessment-1-yolo26s-t1-logic
